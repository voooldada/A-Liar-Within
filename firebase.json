{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/tv",
        "destination": "/tv.html"
      },
      {
        "source": "/spectator",
        "destination": "/spectator.html"
      }
    ]
  }
}
